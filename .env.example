# ─── Database (Neon Postgres) ─────────────────────────────────
# Pegar la connection string de Neon (Dashboard → Connection Details → Pooled connection)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────
# En producción usar la URL de Vercel: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="cambiar-por-secret-aleatorio-de-32-bytes"

# ─── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URIs debe incluir:
#   http://localhost:3000/api/auth/callback/google
#   https://tu-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Mercado Pago ─────────────────────────────────────────────
# Tokens de TEST para desarrollo, PROD cuando vayas a vivo
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# ─── Cloudinary (uploads de imágenes) ─────────────────────────
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email (SMTP) ─────────────────────────────────────────────
# Gmail App Password (recomendado para empezar):
#   1) Activar 2FA en https://myaccount.google.com/security
#   2) Generar App Password en https://myaccount.google.com/apppasswords
#   3) SMTP_USER = email completo, SMTP_PASS = los 16 chars (sin espacios)
# Dejar SMTP_HOST vacío para desactivar todos los envíos.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LegalConnect <tu-email@gmail.com>"

# ─── Cron jobs ────────────────────────────────────────────────
# Vercel Cron envía Authorization: Bearer <CRON_SECRET> automáticamente.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""
